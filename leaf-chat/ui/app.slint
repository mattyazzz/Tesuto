import { HorizontalBox, VerticalBox, LineEdit, TextEdit } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Leaf-Chat";
    width: 1000px;
    height: 700px;
    in property <[string]> mensajes: [];
    // in property <[string]> user: [];
    // THE CALLBACKS
    callback send_msg(string);

    Rectangle {
        background: #111820;

        HorizontalBox {
            // Sidebar
            VerticalBox {
                // logo
                Rectangle {
                    width: 250px;
                    height: 35px;
                    border-radius: 10px;
                    Text {
                        text: "Leaf-Chat";
                        color: #2ca400;
                        font-weight: 700;
                        font-family: "JetBrains Mono";
                        font-italic: true;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-size: 30px;
                    }
                }
                // chat list
                Rectangle {
                    width: 250px;

                    VerticalBox {
                        Text {
                            text: "sidebar";
                            color: white;
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            // chat
            Rectangle {
                background: #0d3a0e;
                border-radius: 10px;
                VerticalBox {
                    // chat header / user
                    Rectangle {
                        height: 50px;
                        background: #111820;
                        border-radius: 10px;
                        Text {
                            text: "lily (me)";
                            color: white;
                            font-size: 20px;
                            font-weight: 700;
                        }
                    }
                    // chat messages
                    Rectangle {
                        VerticalBox {
                            for message in root.mensajes: Text{
                                text: message;
                                color: white;
                                font-size: 16px;
                                font-family: "JetBrains Mono";
                            }
                        }
                    }
                    // chat input
                    Rectangle {
                        height: 50px;
                        background: #111820;
                        border-radius: 10px;
                        input_usuario :=LineEdit {
                            placeholder-text: "type shih";
                            accepted(msg)=> {
                                root.send_msg(msg);
                            }
                            width: 100%;
                        }
                    }
                }
            }
        }
    }
}